#!/usr/bin/env bash
#
# DeepBuddy launcher — runs the distribution against DSH_HOME=~/.deepbuddy so
# its configuration never mixes with the official ~/.dsh (config isolation,
# wave 9).
#
# On first run (when ~/.deepbuddy does not exist) it migrates the user data it
# needs from ~/.dsh by COPYING — the official ~/.dsh is never modified. The
# migration preserves symlinks (cp -RP) because
# profiles/deepbuddy/node_modules/dsh-plugin-deepbuddy points back at this
# repository, and a copied real directory would break hot-reload.
#
# Usage: scripts/deepbuddy [--port N] [--no-open] [dsh args...]
set -euo pipefail

# Repository root = the directory containing this script's parent.
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DSH_BIN="$REPO_ROOT/node_modules/.bin/dsh"

# DeepBuddy's isolated harness home.
DEEP_BUDDY_HOME="$HOME/.deepbuddy"
OFFICIAL_HOME="$HOME/.dsh"

# fail-fast: the dsh executable is a hard prerequisite, never silently skipped.
if [[ ! -x "$DSH_BIN" ]]; then
  echo "deepbuddy: dsh executable not found at $DSH_BIN — run 'pnpm install' in $REPO_ROOT first." >&2
  exit 1
fi

# First run: migrate the officially-owned user data into the isolated root.
if [[ ! -d "$DEEP_BUDDY_HOME" ]]; then
  if [[ ! -d "$OFFICIAL_HOME" ]]; then
    echo "deepbuddy: no ~/.deepbuddy and no ~/.dsh to migrate from — creating an empty home at $DEEP_BUDDY_HOME." >&2
    mkdir -p "$DEEP_BUDDY_HOME/profiles"
  else
    echo "deepbuddy: first run — migrating DeepBuddy configuration from $OFFICIAL_HOME to $DEEP_BUDDY_HOME (copy, ~/.dsh untouched)." >&2
    mkdir -p "$DEEP_BUDDY_HOME"
    mkdir -p "$DEEP_BUDDY_HOME/profiles"

    # Files (copied, never moved — the official home stays byte-identical).
    for f in settings.yaml .credentials.yaml .anonymous-user-id; do
      if [[ -e "$OFFICIAL_HOME/$f" ]]; then
        cp -P "$OFFICIAL_HOME/$f" "$DEEP_BUDDY_HOME/$f"
      fi
    done

    # Directories.  -R recurses, -P preserves symlinks (critical: the profile's
    # dsh-plugin-deepbuddy is a symlink back into this repository).
    for d in .agent-presets storages sessions; do
      if [[ -d "$OFFICIAL_HOME/$d" ]]; then
        cp -RP "$OFFICIAL_HOME/$d" "$DEEP_BUDDY_HOME/$d"
      fi
    done

    # The deepbuddy profile only — never profiles/web or profiles/headless
    # (those are the official distribution's own).
    if [[ -d "$OFFICIAL_HOME/profiles/deepbuddy" ]]; then
      cp -RP "$OFFICIAL_HOME/profiles/deepbuddy" "$DEEP_BUDDY_HOME/profiles/deepbuddy"
    fi

    echo "deepbuddy: migration complete — DeepBuddy data now lives at $DEEP_BUDDY_HOME (source $OFFICIAL_HOME was read-only)." >&2
  fi
else
  echo "deepbuddy: $DEEP_BUDDY_HOME already exists — skipping first-run migration (no merge/sync)." >&2
fi

export DSH_HOME="$DEEP_BUDDY_HOME"
exec "$DSH_BIN" --profile deepbuddy "$@"
